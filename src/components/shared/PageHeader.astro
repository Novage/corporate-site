---
import HeaderArt, { type HeaderArtKind } from "./HeaderArt.astro";

interface Props {
  title: string;
  accent?: string;
  eyebrow?: string;
  eyebrowHref?: string;
  large?: boolean;
  /** Animated art behind the header, chosen to match the page */
  art?: HeaderArtKind;
  /** Size of the art (1 = home hero), chosen to fit this header */
  artSize?: number;
  /** False where the art stays clear of the text: no fade on narrow screens */
  artFade?: boolean;
}

const {
  title,
  accent,
  eyebrow,
  eyebrowHref,
  large = false,
  art,
  artSize,
  artFade,
} = Astro.props;
---

<header class:list={["page-header", { large }]}>
  <div class="container">
    {eyebrow && (
      <div class="section-label">
        {eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
      </div>
    )}
    <h1>
      {title}
      {accent && <span class="accent">{accent}</span>}
    </h1>
    <slot />
  </div>
  {art && <HeaderArt kind={art} size={artSize} fade={artFade} />}
</header>
