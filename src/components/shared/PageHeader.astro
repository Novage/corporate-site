---
interface Props {
  title: string;
  accent?: string;
  eyebrow?: string;
  eyebrowHref?: string;
  large?: boolean;
}

const { title, accent, eyebrow, eyebrowHref, large = false } = Astro.props;
---

<header class:list={["page-header", { large }]}>
  <div class="container">
    {eyebrow && (
      <div class="section-label">
        {eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
      </div>
    )}
    <h1>
      {title}
      {accent && <span class="accent">{accent}</span>}
    </h1>
    <slot />
  </div>
</header>
