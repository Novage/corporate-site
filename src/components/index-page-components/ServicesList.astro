---
import Icon, { type IconName } from "../shared/Icon.astro";
import SectionLabel from "./SectionLabel.astro";

const offers: { title: string; text: string; icon: IconName }[] = [
  {
    title: "Product design & architecture",
    text: "Scope, user experience, and a technical architecture built for real use and scale.",
    icon: "pen-tool",
  },
  {
    title: "Software development",
    text: "Web platforms, enterprise systems, custom tooling, low-level components — any stack that fits the problem.",
    icon: "code",
  },
  {
    title: "Manual & automated QA",
    text: "Structured manual testing and automated suites on every release, before it reaches users.",
    icon: "award",
  },
  {
    title: "Delivery & process management",
    text: "Planning, prioritization, and <strong>clear reporting</strong> — weekly demos and written status — with one point of accountability.",
    icon: "clipboard-list",
  },
  {
    title: "R&D & consulting",
    text: "Applied research for problems without an off-the-shelf answer; architecture reviews and technology selection.",
    icon: "flask",
  },
  {
    title: "Support & optimization",
    text: "<strong>Continuous support</strong> and maintenance, audits, and performance work on systems in production.",
    icon: "gauge",
  },
];
---

<section id="services" class="home-section container">
  <SectionLabel label="What we offer" accent="The complete cycle" />
  <div class="offers-grid">
    {offers.map(({ title, text, icon }) => (
      <article class="offer">
        <div class="icon-tile">
          <Icon name={icon} />
        </div>
        <div>
          <h3>{title}</h3>
          <p set:html={text} />
        </div>
      </article>
    ))}
  </div>
  <p class="callout">
    <strong class="lead">Teams for every need.</strong> We assemble a complete
    team around your product —{" "}
    <strong>
      product designers, software engineers, QA specialists, and delivery
      managers
    </strong>{" "}
    — one accountable unit that <strong>builds</strong> the product,{" "}
    <strong>delivers</strong> it to your users, and <strong>maintains</strong>{" "}
    it in production.
  </p>
</section>
