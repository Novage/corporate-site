---
import "../styles/main.css";

interface Props {
  title: string;
  canonical?: string;
  description?: string;
  /** Open Graph type: "article" for blog posts, "website" otherwise. */
  type?: "website" | "article";
  /** schema.org structured data for this page (without "@context"). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  canonical,
  description = "Novage: software engineering & R&D. We take on the complete development cycle for our clients: product design, development, QA, and delivery.",
  type = "website",
  schema,
} = Astro.props;

const url =
  canonical !== undefined
    ? `${Astro.site}${canonical}`
    : new URL(Astro.url.pathname, Astro.site).href;
const image = `${Astro.site}images/og-default.png`;
const structuredData =
  schema &&
  JSON.stringify(
    Array.isArray(schema)
      ? { "@context": "https://schema.org", "@graph": schema }
      : { "@context": "https://schema.org", ...schema },
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href="/fonts/gstatic-TitilliumWeb-Regular.woff2"
      as="font"
      crossorigin
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="96x96"
      href="/images/favicon-96x96.webp"
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="32x32"
      href="/images/favicon-32x32.webp"
    />
    <link
      rel="icon"
      type="image/webp"
      sizes="16x16"
      href="/images/favicon-16x16.webp"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    {canonical !== undefined && (
      <link rel="canonical" href={`${Astro.site}${canonical}`} />
    )}

    <!-- Cookie-free analytics; counts visits on the live domain only. -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="3f9c88fc-8975-42b8-ac16-e195ad763532"
      data-domains="novage.com.ua"
    ></script>
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Link previews (LinkedIn, Slack, messengers, X) -->
    <meta property="og:site_name" content="Novage" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Novage — software engineering & R&D"
    />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={structuredData}
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
